{
  "name": "humanoid-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "generate": "node scripts/generate-dashboard.mjs",
    "fetch:market": "python3 scripts/fetch_market.py",
    "fetch:market:promote": "python3 scripts/fetch_market.py --promote",
    "fetch:news": "python3 scripts/fetch_news.py",
    "capture:artifact": "node scripts/capture_artifact.mjs",
    "ingest:input": "node scripts/ingest_input.mjs",
    "scheduler:tick": "node scripts/scheduler_tick.mjs",
    "extract:claims": "node scripts/extract_claims.mjs",
    "promote:claim": "node scripts/promote_claim.mjs",
    "route:artifact": "node scripts/route_artifact.mjs",
    "validate": "node scripts/validate-data.mjs",
    "check": "npm run validate && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.9.1",
    "vite": "^6.0.7"
  }
}
