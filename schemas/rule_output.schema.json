{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rule_output.schema.json",
  "title": "Skill Rule Output",
  "type": "object",
  "required": [
    "id",
    "contractVersion",
    "ruleId",
    "pipeline",
    "rawArtifactId",
    "sourceId",
    "generatedAt",
    "claimCandidates",
    "evidenceCandidates",
    "unknowns",
    "followupHints",
    "dataGaps",
    "timeFields",
    "reviewRequirements"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^rout_[0-9]{4}_[0-9]{2}_[0-9]{2}_[a-z0-9_\\-]+$" },
    "contractVersion": { "type": "string", "const": "skill_rule_contract_v0" },
    "ruleId": { "type": "string", "minLength": 1 },
    "pipeline": { "type": "string", "minLength": 1 },
    "rawArtifactId": { "type": "string", "minLength": 1 },
    "sourceId": { "type": "string", "minLength": 1 },
    "routeDecisionId": { "type": "string" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "payloadStatus": { "type": "string", "enum": ["captured_payload", "metadata_only", "missing"] },
    "claimCandidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claimType", "text", "confidence"],
        "properties": {
          "claimType": { "type": "string" },
          "text": { "type": "string", "minLength": 1 },
          "normalizedFact": { "type": "string" },
          "confidence": { "type": "string" },
          "entityIds": { "type": "array", "items": { "type": "string" } },
          "productIds": { "type": "array", "items": { "type": "string" } },
          "occurredAt": { "type": ["string", "null"] },
          "publishedAt": { "type": ["string", "null"] },
          "dueAt": { "type": ["string", "null"] },
          "whyNow": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "evidenceCandidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["relation", "sourceLevel", "strength", "quote"],
        "properties": {
          "relation": { "type": "string" },
          "sourceLevel": { "type": "string", "enum": ["A", "B", "C", "D"] },
          "strength": { "type": "string", "enum": ["strong", "medium", "weak"] },
          "quote": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "reason", "severity"],
        "properties": {
          "field": { "type": "string" },
          "reason": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] }
        },
        "additionalProperties": false
      }
    },
    "followupHints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "description", "priority"],
        "properties": {
          "kind": { "type": "string" },
          "description": { "type": "string" },
          "priority": { "type": "string", "enum": ["low", "medium", "high"] },
          "dueAt": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "dataGaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "description", "severity"],
        "properties": {
          "kind": { "type": "string" },
          "description": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] }
        },
        "additionalProperties": true
      }
    },
    "timeFields": {
      "type": "object",
      "required": ["publishedAt", "firstSeenAt", "capturedAt", "processedAt"],
      "properties": {
        "occurredAt": { "type": ["string", "null"] },
        "publishedAt": { "type": ["string", "null"] },
        "firstSeenAt": { "type": "string" },
        "capturedAt": { "type": "string" },
        "processedAt": { "type": "string" },
        "dueAt": { "type": ["string", "null"] },
        "resolvedAt": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "reviewRequirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "description", "required"],
        "properties": {
          "kind": { "type": "string" },
          "description": { "type": "string" },
          "required": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
