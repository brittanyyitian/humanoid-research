{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pipeline_map.schema.json",
  "title": "Pipeline Map",
  "type": "object",
  "required": ["version", "updatedAt", "routes"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "updatedAt": { "type": "string", "minLength": 1 },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "pipeline", "description", "claimTypes"],
        "properties": {
          "type": { "type": "string" },
          "pipeline": { "type": "string" },
          "description": { "type": "string" },
          "claimTypes": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
