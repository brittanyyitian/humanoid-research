{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "raw_artifact.schema.json",
  "title": "Raw Artifact",
  "type": "object",
  "required": [
    "id",
    "artifactType",
    "title",
    "publisher",
    "url",
    "sourceId",
    "fetchRunId",
    "firstSeenAt",
    "capturedAt",
    "contentHash",
    "status"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^raw_[0-9]{4}_[0-9]{2}_[0-9]{2}_[a-z0-9_\\-]+$" },
    "artifactType": {
      "type": "string",
      "enum": [
        "webpage",
        "product_page",
        "news_page",
        "filing",
        "pdf",
        "video_transcript",
        "wechat",
        "market_quote",
        "serenity_output"
      ]
    },
    "title": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "pattern": "^https?://" },
    "sourceId": { "type": "string" },
    "fetchRunId": { "type": "string" },
    "publishedAt": { "type": ["string", "null"] },
    "firstSeenAt": { "type": "string", "minLength": 1 },
    "capturedAt": { "type": "string", "minLength": 1 },
    "contentHash": { "type": "string", "minLength": 1 },
    "storagePath": { "type": ["string", "null"] },
    "entityIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "claimIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": { "type": "string", "enum": ["active", "archived", "superseded"] },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
