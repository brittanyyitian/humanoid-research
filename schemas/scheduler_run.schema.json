{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scheduler_run.schema.json",
  "title": "Scheduler Run",
  "type": "object",
  "required": [
    "id",
    "mode",
    "dryRun",
    "status",
    "startedAt",
    "finishedAt",
    "sourceCount",
    "selectedCount",
    "dueCount",
    "attemptedCount",
    "successCount",
    "failureCount",
    "skippedCount",
    "cadenceKeys",
    "results"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^sched_[0-9]{4}_[0-9]{2}_[0-9]{2}_[a-z0-9_\\-]+$" },
    "mode": { "type": "string", "enum": ["tick"] },
    "dryRun": { "type": "boolean" },
    "status": { "type": "string", "enum": ["success", "partial", "failed", "skipped", "dry_run"] },
    "startedAt": { "type": "string", "minLength": 1 },
    "finishedAt": { "type": ["string", "null"] },
    "sourceCount": { "type": "integer", "minimum": 0 },
    "selectedCount": { "type": "integer", "minimum": 0 },
    "dueCount": { "type": "integer", "minimum": 0 },
    "attemptedCount": { "type": "integer", "minimum": 0 },
    "successCount": { "type": "integer", "minimum": 0 },
    "failureCount": { "type": "integer", "minimum": 0 },
    "skippedCount": { "type": "integer", "minimum": 0 },
    "cadenceKeys": {
      "type": "array",
      "items": { "type": "string", "enum": ["market", "filing", "industry"] }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceId", "cadenceKey", "inputType", "url", "status", "reason"],
        "properties": {
          "sourceId": { "type": "string" },
          "cadenceKey": { "type": "string", "enum": ["market", "filing", "industry"] },
          "inputType": { "type": "string", "enum": ["url", "rss", "api", "manual"] },
          "url": { "type": "string", "pattern": "^https?://" },
          "status": { "type": "string", "enum": ["success", "failed", "planned"] },
          "reason": { "type": "string", "minLength": 1 },
          "rawArtifactId": { "type": ["string", "null"] },
          "routeDecisionId": { "type": ["string", "null"] },
          "pipelineTaskId": { "type": ["string", "null"] },
          "pipeline": {
            "type": ["string", "null"],
            "enum": [
              "company_pipeline",
              "product_pipeline",
              "filing_pipeline",
              "event_pipeline",
              "policy_pipeline",
              "supply_chain_pipeline",
              null
            ]
          },
          "error": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
