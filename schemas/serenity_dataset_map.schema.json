{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "serenity_dataset_map.schema.json",
  "title": "Serenity Bridge Dataset Map",
  "type": "object",
  "required": ["version", "updatedAt", "policy", "datasets", "blockedDatasets", "sourceLevelMap"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "updatedAt": { "type": "string", "minLength": 1 },
    "policy": { "type": "string", "minLength": 1 },
    "datasets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["mode", "artifactType", "sourceType", "route", "enqueuePipeline", "description"],
        "properties": {
          "mode": { "type": "string", "minLength": 1 },
          "artifactType": { "type": "string", "minLength": 1 },
          "sourceType": { "type": "string", "minLength": 1 },
          "route": { "type": "boolean" },
          "enqueuePipeline": { "type": "boolean" },
          "description": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "blockedDatasets": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sourceLevelMap": {
      "type": "object",
      "additionalProperties": { "type": "string", "enum": ["A", "B", "C", "D"] }
    }
  },
  "additionalProperties": false
}
