{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "state_transition.schema.json",
  "title": "State Transition",
  "type": "object",
  "required": [
    "id",
    "subjectType",
    "subjectId",
    "fromStatus",
    "toStatus",
    "occurredAt",
    "reason"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^st_[0-9]{4}_[0-9]{2}_[0-9]{2}_[a-z0-9_\\-]+$" },
    "subjectType": { "type": "string", "enum": ["claim", "followup", "event", "milestone", "source"] },
    "subjectId": { "type": "string", "minLength": 1 },
    "fromStatus": { "type": "string", "minLength": 1 },
    "toStatus": { "type": "string", "minLength": 1 },
    "occurredAt": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "evidenceIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sourceIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "actor": { "type": "string" }
  },
  "additionalProperties": false
}
