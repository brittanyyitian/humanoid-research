{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence.schema.json",
  "title": "Evidence",
  "type": "object",
  "required": [
    "id",
    "claimId",
    "rawArtifactId",
    "sourceId",
    "relation",
    "sourceLevel",
    "strength",
    "capturedAt",
    "assessedAt"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^evd_[0-9]{4}_[0-9]{2}_[0-9]{2}_[a-z0-9_\\-]+$" },
    "claimId": { "type": "string" },
    "rawArtifactId": { "type": "string" },
    "sourceId": { "type": "string" },
    "ruleOutputId": { "type": "string" },
    "relation": { "type": "string", "enum": ["supports", "mentions", "refutes", "updates"] },
    "sourceLevel": { "type": "string", "enum": ["A", "B", "C", "D"] },
    "strength": { "type": "string", "enum": ["strong", "medium", "weak"] },
    "quote": { "type": "string" },
    "capturedAt": { "type": "string", "minLength": 1 },
    "assessedAt": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
