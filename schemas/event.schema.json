{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "title": "Research Event",
  "type": "object",
  "required": [
    "id",
    "date",
    "eventType",
    "module",
    "entityIds",
    "title",
    "fact",
    "sourceIds",
    "evidenceLevel",
    "createdAt"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^evt_[0-9]{4}_[0-9]{2}_[0-9]{2}_[a-z0-9_\\-]+$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "eventType": {
      "type": "string",
      "enum": [
        "order",
        "ipo",
        "funding",
        "conference",
        "policy",
        "partnership",
        "demo",
        "factory",
        "hiring",
        "patent",
        "product",
        "delivery",
        "announcement",
        "financial_report"
      ]
    },
    "module": { "type": "string", "minLength": 1 },
    "entityIds": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "title": { "type": "string", "minLength": 1 },
    "fact": { "type": "string", "minLength": 1 },
    "importance": { "type": "integer", "minimum": 1, "maximum": 5 },
    "sourceIds": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "evidenceLevel": { "type": "string", "enum": ["A", "B", "C", "D"] },
    "createdAt": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}

