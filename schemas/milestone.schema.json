{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "milestone.schema.json",
  "title": "Research Milestone",
  "type": "object",
  "required": [
    "id",
    "title",
    "dueAt",
    "dueAtPrecision",
    "status",
    "entityIds",
    "sourceIds",
    "createdAt"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^mile_[0-9]{4}_[0-9]{2}_[0-9]{2}_[a-z0-9_\\-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "dueAt": { "type": "string", "minLength": 1 },
    "dueAtPrecision": { "type": "string", "enum": ["day", "month", "quarter", "year", "window"] },
    "status": { "type": "string", "enum": ["upcoming", "due", "resolved", "stale", "cancelled"] },
    "entityIds": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "claimIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "followupIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sourceIds": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "createdAt": { "type": "string", "minLength": 1 },
    "resolvedAt": { "type": ["string", "null"] },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
