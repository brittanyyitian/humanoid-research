{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stock-snapshot.schema.json",
  "title": "Stock Snapshot",
  "type": "object",
  "required": [
    "id",
    "date",
    "time",
    "snapshotType",
    "isFinal",
    "entityId",
    "stockCode",
    "market",
    "sourceIds",
    "capturedAt"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^stk_[0-9]{4}_[0-9]{2}_[0-9]{2}_[a-z0-9_\\-]+$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "time": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$" },
    "snapshotType": { "type": "string", "enum": ["preopen", "intraday", "midday", "close"] },
    "isFinal": { "type": "boolean" },
    "entityId": { "type": "string" },
    "stockCode": { "type": "string" },
    "market": { "type": "string" },
    "close": { "type": ["number", "null"] },
    "price": { "type": ["number", "null"] },
    "changePct": { "type": ["number", "null"] },
    "turnoverAmount": { "type": ["string", "null"] },
    "turnoverRate": { "type": ["number", "null"] },
    "mainNetInflow": { "type": ["string", "null"] },
    "changePct5d": { "type": ["number", "null"] },
    "changePct20d": { "type": ["number", "null"] },
    "sourceIds": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "capturedAt": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}

