{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim.schema.json",
  "title": "Claim",
  "type": "object",
  "required": [
    "id",
    "claimType",
    "text",
    "entityIds",
    "artifactIds",
    "status",
    "reviewStatus",
    "confidence",
    "publishedAt",
    "firstSeenAt",
    "capturedAt",
    "processedAt"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^claim_[0-9]{4}_[0-9]{2}_[0-9]{2}_[a-z0-9_\\-]+$" },
    "claimType": {
      "type": "string",
      "enum": [
        "product_release",
        "product_spec",
        "delivery",
        "order",
        "partnership",
        "filing",
        "financial",
        "market_snapshot",
        "milestone",
        "source_health",
        "data_gap",
        "other"
      ]
    },
    "text": { "type": "string", "minLength": 1 },
    "normalizedFact": { "type": "string" },
    "entityIds": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "productIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "artifactIds": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "status": { "type": "string", "enum": ["candidate", "needs_review", "verified", "refuted", "superseded", "stale"] },
    "reviewStatus": { "type": "string", "enum": ["inbox", "promoted", "rejected", "merged", "needs_followup"] },
    "confidence": { "type": "string", "enum": ["high", "medium", "low", "unknown"] },
    "occurredAt": { "type": ["string", "null"] },
    "publishedAt": { "type": ["string", "null"] },
    "firstSeenAt": { "type": "string", "minLength": 1 },
    "capturedAt": { "type": "string", "minLength": 1 },
    "processedAt": { "type": "string", "minLength": 1 },
    "dueAt": { "type": ["string", "null"] },
    "resolvedAt": { "type": ["string", "null"] },
    "promotedEventIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "promotedFollowupIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "ruleOutputIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "unknowns": {
      "type": "array",
      "items": { "type": "object" }
    },
    "followupHints": {
      "type": "array",
      "items": { "type": "object" }
    },
    "dataGaps": {
      "type": "array",
      "items": { "type": "object" }
    },
    "reviewRequirements": {
      "type": "array",
      "items": { "type": "object" }
    },
    "whyNow": { "type": "string" },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
