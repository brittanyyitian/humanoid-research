{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Serenity Benchmark Case",
  "type": "object",
  "required": [
    "name",
    "prompt",
    "market_scope",
    "excluded_boards",
    "shortlist_target",
    "preflight_snapshot",
    "assertions"
  ],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "prompt": { "type": "string", "minLength": 1 },
    "market_scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "excluded_boards": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "max_price": { "type": ["number", "null"] },
    "min_price": { "type": ["number", "null"] },
    "themes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "shortlist_target": { "type": "integer", "minimum": 1 },
    "preflight_snapshot": { "type": "object" },
    "universes": {
      "type": "array",
      "items": { "type": "object" }
    },
    "assertions": {
      "type": "object",
      "properties": {
        "min_shortlist_count": { "type": "integer", "minimum": 0 },
        "max_shortlist_count": { "type": "integer", "minimum": 0 },
        "forbidden_selected_symbols": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "must_include_layer_keys": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "required_pool_contexts": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["EMPTY", "SAME_LAYER_COMPARISON", "SAME_THEME_DIFFERENT_LAYERS", "CROSS_THEME_DIAGNOSTIC"]
          }
        },
        "max_low_price_bonus_cap": { "type": "number", "minimum": 0 },
        "selected_quality_floor_status": {
          "type": "string",
          "enum": ["PASS", "PENDING_PREFLIGHT", "BLOCKED"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
