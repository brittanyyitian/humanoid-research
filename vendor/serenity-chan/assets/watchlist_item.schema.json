{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Serenity Watchlist",
  "type": "object",
  "required": [
    "contract_type",
    "schema_version",
    "generated_at",
    "source_report_path",
    "summary",
    "items"
  ],
  "properties": {
    "contract_type": {
      "type": "string",
      "const": "serenity_watchlist"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "source_report_path": {
      "type": "string"
    },
    "last_reviewed_at": {
      "type": "string"
    },
    "review_summary": {
      "type": "object",
      "required": [
        "applied_count",
        "outcome_count",
        "source_reviewed_at"
      ],
      "properties": {
        "applied_count": {
          "type": "integer",
          "minimum": 0
        },
        "outcome_count": {
          "type": "integer",
          "minimum": 0
        },
        "source_reviewed_at": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "item_count",
        "action_candidate_count",
        "evidence_first_count",
        "watchlist_count"
      ],
      "properties": {
        "item_count": {
          "type": "integer",
          "minimum": 0
        },
        "action_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_first_count": {
          "type": "integer",
          "minimum": 0
        },
        "watchlist_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "symbol",
          "name",
          "watch_state",
          "research_priority_score",
          "action_priority_score",
          "primary_gate",
          "primary_gate_class",
          "quality_score",
          "quality_band",
          "upgrade_conditions",
          "downgrade_conditions",
          "triggers",
          "next_evidence",
          "evidence_debt"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "watch_state": {
            "type": "string",
            "enum": [
              "ACTION_CANDIDATE",
              "EVIDENCE_FIRST",
              "WAIT_FOR_BUY_POINT",
              "WATCHLIST"
            ]
          },
          "research_priority_score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "action_priority_score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "primary_gate": {
            "type": "string"
          },
          "primary_gate_class": {
            "type": "string"
          },
          "quality_score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "quality_band": {
            "type": "string"
          },
          "upgrade_conditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "downgrade_conditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "triggers": {
            "type": "object",
            "required": [
              "30d",
              "90d",
              "180d"
            ],
            "properties": {
              "30d": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "90d": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "180d": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          },
          "next_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_debt": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "last_reviewed_at": {
            "type": "string"
          },
          "next_review_due_at": {
            "type": "string"
          },
          "removed": {
            "type": "boolean"
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "reviewed_at",
                "horizon",
                "judgment_delta",
                "action_delta",
                "next_state"
              ],
              "properties": {
                "reviewed_at": {
                  "type": "string",
                  "minLength": 1
                },
                "horizon": {
                  "type": "string",
                  "enum": [
                    "30d",
                    "90d",
                    "180d"
                  ]
                },
                "judgment_delta": {
                  "type": "string",
                  "minLength": 1
                },
                "action_delta": {
                  "type": "string",
                  "minLength": 1
                },
                "checked_evidence": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "next_state": {
                  "type": "string",
                  "minLength": 1
                },
                "next_review_date": {
                  "type": "string"
                },
                "notes": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "condition_probes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "description",
                "probe"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "upgrade",
                    "downgrade"
                  ]
                },
                "description": {
                  "type": "string"
                },
                "probe": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": [
                    "type",
                    "operator",
                    "threshold"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "price_threshold",
                        "field_threshold",
                        "static_value",
                        "json_path_threshold"
                      ]
                    },
                    "symbol": {
                      "type": "string"
                    },
                    "field": {
                      "type": "string"
                    },
                    "operator": {
                      "enum": [
                        ">",
                        ">=",
                        "<",
                        "<=",
                        "=",
                        "=="
                      ]
                    },
                    "threshold": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "previous_merge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "previous_generated_at": {
          "type": "string"
        },
        "carried_item_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "carried_item_count"
      ]
    },
    "scorecard_merge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "type": "string"
        },
        "replaced_existing": {
          "type": "boolean"
        }
      },
      "required": [
        "symbol"
      ]
    }
  },
  "additionalProperties": false
}
