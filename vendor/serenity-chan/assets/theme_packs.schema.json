{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Serenity Theme Pack Registry",
  "type": "object",
  "required": ["contract_type", "schema_version", "generated_at", "packs"],
  "properties": {
    "contract_type": { "type": "string", "const": "serenity_theme_pack_registry" },
    "schema_version": { "type": "string", "const": "1.0" },
    "generated_at": { "type": "string", "minLength": 1 },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "as_of", "freshness_days", "source_notes"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "freshness_days": { "type": "integer", "minimum": 1 },
          "source_notes": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
